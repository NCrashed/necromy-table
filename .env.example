# Copy to .env (gitignored) and fill in. `nix develop` loads it automatically.
OPENAI_API_KEY=
PIXELLAB_API_KEY=
# Hugging Face read token for the gated Stable Audio 3 weights (scripts/stable-audio.sh).
HF_TOKEN=

# Optional overrides for scripts/gpt-image.sh
# GPT_IMAGE_MODEL=gpt-image-2.5-flare        # text-to-image
# GPT_IMAGE_EDIT_MODEL=gpt-image-2.5-sunburst # generation from reference images

# The NVIDIA GPU on the nouveau/NVK driver randomly loses its graphics
# channel (kernel: "gsp: rc ... type:109", "channel killed") in any app,
# and Bevy then quits with DeviceLost. Uncomment to render on the Intel iGPU.
# WGPU_POWER_PREF=low